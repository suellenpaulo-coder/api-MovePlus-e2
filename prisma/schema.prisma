
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Exercicio {
  id            String   @id @default(uuid())
  nome          String
  descricao     String
  grupoMuscular String
  equipamento   String
  series        Int
  repeticoes    Int
  imagem        String   @default("exercicio-padrao.png")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
