
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Exercicio {
  id          Int      @id
  alunoId     Int
  name        String
  muscleGroup String
  date        DateTime @default(now())
  sets        Int
  repetitions Int
  weight      Float?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
